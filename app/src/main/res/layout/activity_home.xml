<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="28dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="36sp" android:textStyle="bold" android:textColor="#116D67" android:layout_marginBottom="56dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_title" android:textSize="28sp" android:textStyle="bold" android:textColor="#173A53" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_subtitle" android:textSize="16sp" android:textColor="#526779" android:layout_marginTop="8dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/signed_in_as" android:textSize="15sp" android:textColor="#526779" android:layout_marginTop="40dp" />
    <TextView android:id="@+id/account_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="19sp" android:textColor="#173A53" android:layout_marginTop="8dp" />
    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <Button android:id="@+id/sign_out" android:layout_width="match_parent" android:layout_height="56dp" android:background="@drawable/button_background" android:backgroundTint="#173A53" android:text="@string/sign_out" android:textColor="#FFFFFF" android:textSize="17sp" android:textAllCaps="false" />
</LinearLayout>
